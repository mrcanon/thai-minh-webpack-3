extends templates/layouts/one-colum.jade
block head
  +head('Project', 'description', 'keywords', '', '', '', '')
block content
  section.panel-banner(data-parallax="true")
    .container
      .banner-inner
          .banner-cover
            .banner-table
              h2.banner-heading dự án
  //.panel-banner
  section.panel-work(data-grid='{"sortBy" : "random"}')
    .container
      h2.heading-common các công trình
      ul.work-filter
        li.is-filter
          a(href="#", data-filter="*") Tất cả
        li
          a(href="#", data-filter=".completed") Hoàn thành
        li
          a(href="#", data-filter=".active") Đang thi công
      .grid.work-grids
        .grid-sizer.col-sm-6.col-md-4
        +work('#', 'Construction', 'assets/img/data/work-9.jpg', 'completed')
        +work('#', 'building renovation', 'assets/img/data/work-8.jpg', 'completed')
        +work('#', 'project management', 'assets/img/data/work-7.jpg', 'active')
        +work('#', 'Construction', 'assets/img/data/work-6.jpg', 'completed')
        +work('#', 'building renovation', 'assets/img/data/work-5.jpg', 'active')
        +work('#', 'project management', 'assets/img/data/work-4.jpg', 'completed')
        +work('#', 'Construction', 'assets/img/data/work-3.jpg', 'completed')
        +work('#', 'building renovation', 'assets/img/data/work-2.jpg', 'active')
        +work('#', 'project management', 'assets/img/data/work-1.jpg', 'active')    
      ul.paging
        +menu('#', '1', 'active')
        +menu('#', '2', '')
        +menu('#', '3', '')
        +menu('#', '»', '')
  //.panel-work