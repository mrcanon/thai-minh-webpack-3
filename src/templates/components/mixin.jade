mixin head(title, description, keywords, description_social, image_social, url_social, type_social)
  title #{title}
  meta(name="description", content="#{description}")
  meta(name="keywords", content="#{keywords}")
  meta(property="og:title" content="#{title}")
  if typeof(description_social) !== 'undefined' && description_social != ""
    meta(property="og:description" content="#{description_social}")
  if typeof(image_social) !== 'undefined' && image_social != ""
    meta(property="og:image" content="#{image_social}")
  if typeof(url_social) !== 'undefined' && url_social != ""
    meta(property="og:url" content="#{url_social}")
  if typeof(type_social) !== 'undefined' && type_social != ""
    meta(property="og:type" content="#{type_social}")
  else
    meta(property="og:type" content="website")

mixin menu(link, title, current)
  if current != ""
    li(class="#{current}")
      a(href="#{link}", title="#{title}") !{title}
  else
    li
      a(href="#{link}", title="#{title}") !{title}

mixin about(title, link, src, content)
  article.about-item 
    .about-media
      a(href="#{link}", title="#{title}")
        img(src="#{src}", width="370", height="241", alt="#{title}")
    h3.about-heading
      a(href="#{link}", title="#{title}") #{title}
    p.about-content #{content}

mixin plan(src, title, description)
  .plan-item  
    .plan-media
      img(src="#{src}", width="178", height="134", alt="#{title}")
    .plan-title !{title}
    .plan-desc #{description}

mixin project(link, title, src)
  .project-item
    img(src="#{src}", width="360", height="340", alt="#{title}")
    a.project-inner(href="#{link}")
      .project-table
        .project-cell
          .project-heading #{title}
          .project-search 
            i.fa.fa-search

mixin partner(link, title, className)
  a.partner-item(href="#{link}", title="#{title}", class='#{className}') 
    span #{title} 

mixin core(icon, title, summary)
  article.core-item
    i.core-icon.fa(class="#{icon}")
    h3.core-title #{title}
    p.core-summary #{summary}

mixin work(link, title, src, filter)
  .grid-item.col-sm-6.col-md-4(class="#{filter}")
    article.work-item
      a.work-media(href="#{link}")
        img(src="#{src}", width="740", height="480", alt="#{title}")
        i.work-icon.fa.fa-search
      h3.work-title
        a(href="#{link}") #{title}

mixin owl-sycn(title, src, width, height)
  .item
    img(src="#{src}", width="#{width}", height="#{height}", alt="#{title}")

mixin project-relative(link, title, src)
  article.work-item
      a.work-media(href="#{link}")
        img(src="#{src}", width="740", height="480", alt="#{title}")
        i.work-icon.fa.fa-search
      h3.work-title
        a(href="#{link}") #{title}

mixin job(title, link, summary, date) 
  .col-sm-6
    article.job-item 
      h3.job-heading 
        a(href="#{link}", title="#{title}") #{title}
      .job-content
        p.job-summary #{summary}
        p.job-post #{date}